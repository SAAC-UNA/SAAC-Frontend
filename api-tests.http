### ========================================
### API ENDPOINTS PARA ROLES - SAAC BACKEND
### ========================================
### Asegúrate de que el servidor esté corriendo con: php artisan serve
### Base URL: http://localhost:8000/api
@baseUrl = http://localhost:8000/api

### Base URL: http://127.0.0.1:8000/api
@baseUrl = http://127.0.0.1:8000/api

### ========================================
### 1. LISTAR PERMISOS DISPONIBLES
### ========================================
GET {{baseUrl}}/roles/permisos
Accept: application/json
Content-Type: application/json

### ========================================
### 2. CREAR ROL NUEVO
### ========================================
POST {{baseUrl}}/roles/crear
Accept: application/json
Content-Type: application/json

{
    "name": "Administrador de Prueba",
    "description": "Rol de prueba creado desde REST Client",
    "permissions": ["view_users", "create_roles", "edit_roles"]
}

### ========================================
### 3. CREAR ROL CON MÁS PERMISOS
### ========================================
POST {{baseUrl}}/roles/crear
Accept: application/json
Content-Type: application/json

{
    "name": "Super Administrador",
    "description": "Rol con todos los permisos del sistema",
    "permissions": ["view_users", "create_roles", "edit_roles", "delete_roles", "manage_courses", "view_reports", "system_admin"]
}

### ========================================
### 4. LISTAR TODOS LOS ROLES
### ========================================
GET {{baseUrl}}/roles
Accept: application/json
Content-Type: application/json

### ========================================
### 5. VER ROL ESPECÍFICO (ID: 1)
### ========================================
GET {{baseUrl}}/roles/1
Accept: application/json
Content-Type: application/json

### ========================================
### 6. VER ROL ESPECÍFICO (ID: 2)
### ========================================
GET {{baseUrl}}/roles/2
Accept: application/json
Content-Type: application/json

### ========================================
### 7. ACTUALIZAR ROL (ID: 1)
### ========================================
PUT {{baseUrl}}/roles/1
Accept: application/json
Content-Type: application/json

{
    "name": "Administrador Actualizado",
    "description": "Descripción actualizada del rol de administrador",
    "permissions": ["view_users", "create_roles", "edit_roles", "delete_roles", "view_reports"]
}

### ========================================
### 8. ELIMINAR ROL (ID: 2) - ¡CUIDADO!
### ========================================
DELETE {{baseUrl}}/roles/2
Accept: application/json
Content-Type: application/json

### ========================================
### 9. PRUEBA DE ERROR - CREAR ROL SIN NOMBRE
### ========================================
POST {{baseUrl}}/roles/crear
Accept: application/json
Content-Type: application/json

{
    "description": "Rol sin nombre para probar validación",
    "permissions": ["view_users"]
}

### ========================================
### 10. PRUEBA DE ERROR - CREAR ROL SIN PERMISOS
### ========================================
POST {{baseUrl}}/roles/crear
Accept: application/json
Content-Type: application/json

{
    "name": "Rol Sin Permisos",
    "description": "Rol sin permisos para probar validación",
    "permissions": []
}

### ========================================
### 11. PRUEBA DE ERROR - PERMISOS INVÁLIDOS
### ========================================
POST {{baseUrl}}/roles/crear
Accept: application/json
Content-Type: application/json

{
    "name": "Rol con Permisos Inválidos",
    "description": "Rol con permisos que no existen",
    "permissions": ["permiso_inexistente", "otro_permiso_falso"]
}